# Environment Variables

# Database
POSTGRES_USER=kartas_user
POSTGRES_PASSWORD=kartas_password_change_in_production
POSTGRES_DB=kartas_db
DATABASE_URL=postgresql://kartas_user:kartas_password_change_in_production@postgres:5432/kartas_db

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API
API_PORT=3000
NODE_ENV=development

# Frontend
VITE_API_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:5173

# Email provider for sending invite emails: "smtp" (default) or "gmail".
# Leave both provider's credentials blank to disable email — invites fall back to link-only mode.
EMAIL_PROVIDER=smtp

# Used when EMAIL_PROVIDER=smtp (generic SMTP server)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Used when EMAIL_PROVIDER=gmail
# GMAIL_APP_PASSWORD is a Google App Password, NOT the account login password —
# requires 2-Step Verification enabled; generate at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Sender display shown on outgoing invite emails (optional — falls back to the
# active provider's user address; Gmail may override this to the authenticated account anyway)
EMAIL_FROM=
