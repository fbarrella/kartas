# Environment Variables

# Database
POSTGRES_USER=kira_user
POSTGRES_PASSWORD=kira_password_change_in_production
POSTGRES_DB=kira_db
DATABASE_URL=postgresql://kira_user:kira_password_change_in_production@postgres:5432/kira_db

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API
API_PORT=3000
NODE_ENV=development

# Frontend
VITE_API_URL=http://localhost:3000/api
